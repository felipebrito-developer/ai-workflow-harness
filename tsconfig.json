{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@harness/*": ["./packages/*/src"]
    }
  },
  "exclude": ["node_modules", "dist", "templates"]
}