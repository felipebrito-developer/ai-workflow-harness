{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-r1",
  "instructions": [
    ".harness/spec/app-summary.md",
    ".harness/standards/**/*.md",
    ".harness/skills/**/*.md",
    "opencode.md"
  ],
  "agent": {
    "planner": {
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-r1",
      "description": "Reasoning agent (@planner) for architecture planning, living spec slicing, and task manifest creation.",
      "permission": {
        "task": {
          "*": "allow",
          "web-builder": "allow",
          "backend-builder": "allow"
        },
        "external_directory": "deny"
      }
    },
    "web-builder": {
      "mode": "subagent",
      "model": "openrouter/qwen/qwen-2.5-coder-32b-instruct",
      "description": "Web builder agent (@web-builder) executing React web frontend implementation tasks.",
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "external_directory": "deny"
      }
    },
    "backend-builder": {
      "mode": "subagent",
      "model": "openrouter/qwen/qwen-2.5-coder-32b-instruct",
      "description": "Backend builder agent (@backend-builder) executing API and domain implementation tasks.",
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "external_directory": "deny"
      }
    }
  },
  "provider": {
    "openrouter": {
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "setCacheKey": true
      }
    }
  }
}